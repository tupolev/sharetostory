{
  "manifest_version": 3,
  "name": "ShareToStory",
  "version": "1.0.3",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content/preview-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content/messages.js",
        "content/inject.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "120",
  "host_permissions": [
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background/preview.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/story-video.mjs",
        "vendor/mediabunny.min.mjs"
      ],
      "matches": [
        "https://www.instagram.com/*"
      ]
    }
  ],
  "default_locale": "en"
}
